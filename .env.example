APP_NAME=APEXIVEAI Global Trademark Intelligence
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False

HOST=0.0.0.0
PORT=8081

API_PREFIX=/api/v1

# Optional: leave empty to disable API key authentication
API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/trademark_conflict_db?sslmode=disable
DATABASE_SCHEMA=public
DATABASE_TABLE=trademarks

# Qdrant
QDRANT_URL=https://YOUR_QDRANT_CLUSTER:6333
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=real_trademark_embeddings
VECTOR_DIMENSION=512

# OpenCLIP
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Search
SEARCH_LIMIT=10
MAX_UPLOAD_SIZE=15728640

# Frontend CORS
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190,https://www.apexiveai.com